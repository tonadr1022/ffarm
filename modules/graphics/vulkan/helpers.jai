convert_vk_format :: (format: VkFormat) -> TextureFormat {
    return cast(TextureFormat) xx format;
}

convert :: (using rect2D: Rect2D) -> VkRect2D {
    return .{offset=.{offset.x, offset.y}, extent=.{extent.width, extent.height}};
}

convert :: (using extent3D: Extent3D) -> VkExtent3D {
    return .{width=width, height=height, depth=depth};
}

convert :: (format: TextureFormat) -> VkFormat {
    if format == {
        case TextureFormat.UNDEFINED; return VkFormat.UNDEFINED;
        case TextureFormat.R4G4_UNORM_PACK8; return VkFormat.R4G4_UNORM_PACK8;
